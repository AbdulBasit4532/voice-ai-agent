# ---- Server ----
PORT=4710
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Public URL that Vapi can reach (ngrok / Railway / Render URL, no trailing slash)
PUBLIC_BASE_URL=https://your-app.up.railway.app

# ---- Database ----
# Path to the SQLite file. Put this on a persistent volume in production.
DATABASE_PATH=./data/patients.db
# Insert 2 demo patients on first boot (true/false)
SEED_ON_BOOT=true

# ---- Vapi (telephony + STT/TTS + LLM orchestration) ----
# Private API key from https://dashboard.vapi.ai -> Organization Settings -> API Keys
VAPI_API_KEY=
# Shared secret we tell Vapi to send in the `x-vapi-secret` header on every webhook.
# Generate with: openssl rand -hex 24
VAPI_SERVER_SECRET=change-me
# Optional: reuse an existing assistant / phone number instead of creating new ones
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=
# Area code preference for the free Vapi number (optional)
VAPI_AREA_CODE=
# PUBLIC key (dashboard -> API Keys -> Public). Safe for browsers. Enables the
# "Talk to the agent" button on /dashboard so you can test without any phone.
VAPI_PUBLIC_KEY=

# ---- Twilio (optional) ----
# If Vapi cannot give you a free U.S. number, buy a U.S. number on Twilio (works from any
# country) and set these; the provision script imports it into Vapi instead.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ---- OpenAI (used by the local text simulator only; Vapi uses its own key) ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
